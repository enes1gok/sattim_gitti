{
  "name": "mobile-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "catalog:prepare": "node scripts/prepare-vehicle-catalog.mjs",
    "test:catalog": "node --test tests/vehicle-catalog.test.mjs",
    "test:decision": "node --test tests/decision-data.test.ts",
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "build:reconstruction": "mkdir -p .local/bin && xcrun swiftc -parse-as-library -O -module-cache-path /private/tmp/sattim-swift-module-cache server/native/Reconstruct.swift server/native/AppearanceExport.swift -o .local/bin/reconstruct && xcrun swiftc -parse-as-library -O -module-cache-path /private/tmp/sattim-swift-module-cache server/native/RenderMasks.swift -o .local/bin/render-masks",
    "dev:reconstruction": "node server/reconstruction.mjs",
    "test:reconstruction": "node --test tests/model-file.test.ts tests/capture-policy.test.ts tests/reconstruction.test.mjs tests/mobile-model.test.mjs tests/camera-still.test.mjs tests/appearance.test.mjs tests/vehicle-camera.test.mjs tests/photo-tour.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@supabase/supabase-js": "2.118.0",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "busboy": "1.6.0",
    "obj2gltf": "3.2.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "@sparkjsdev/spark": "2.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3",
    "@types/three": "0.186.0"
  }
}
